From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ci <a@b>
Date: Sun, 8 Nov 2026 17:30:00 +0800
Subject: [PATCH 75/75] media: sprd-vsp: add a V4L2 JPEG decoder for the JPEG codec

Baseline JPEG (4:2:0, 4:2:2, 4:4:4, greyscale) through the sequence measured
with the register lab. The block is power cycled for every image, the tables are
reloaded, the stream is copied into a buffer of its own with EOI and 254 zero
bytes behind it, and one start is given per MCU row. Only the standard Huffman
tables are decoded, other streams are refused.
---
diff --git a/drivers/media/platform/sprd/vsp/vsp.h b/drivers/media/platform/sprd/vsp/vsp.h
--- a/drivers/media/platform/sprd/vsp/vsp.h
+++ b/drivers/media/platform/sprd/vsp/vsp.h
@@ -53,11 +53,15 @@
 	struct delayed_work watchdog;
 	int irq;
 	bool v4l2_registered;
+	bool jpeg_registered;
 };
 
 int sprd_vsp_dec_register(struct sprd_vsp *vsp);
 void sprd_vsp_dec_unregister(struct sprd_vsp *vsp);
 
+int sprd_vsp_jpeg_register(struct sprd_vsp *vsp);
+void sprd_vsp_jpeg_unregister(struct sprd_vsp *vsp);
+
 void sprd_vsp_lab_register(struct sprd_vsp *vsp);
 void sprd_vsp_lab_unregister(struct sprd_vsp *vsp);
 
diff --git a/drivers/media/platform/sprd/vsp/vsp.c b/drivers/media/platform/sprd/vsp/vsp.c
--- a/drivers/media/platform/sprd/vsp/vsp.c
+++ b/drivers/media/platform/sprd/vsp/vsp.c
@@ -187,6 +187,9 @@
 			dev_warn(dev, "decoder not registered: %d\n", ret);
 	} else {
 		sprd_vsp_lab_register(vsp);
+		ret = sprd_vsp_jpeg_register(vsp);
+		if (ret)
+			dev_warn(dev, "JPEG decoder not registered: %d\n", ret);
 	}
 
 	dev_info(dev, "ready; cat /sys/kernel/debug/%s/regs powers it and dumps its registers\n",
@@ -200,6 +203,7 @@
 	struct sprd_vsp *vsp = platform_get_drvdata(pdev);
 
 	sprd_vsp_dec_unregister(vsp);
+	sprd_vsp_jpeg_unregister(vsp);
 	sprd_vsp_lab_unregister(vsp);
 	debugfs_remove_recursive(vsp->dir);
 }
diff --git a/drivers/media/platform/sprd/vsp/Makefile b/drivers/media/platform/sprd/vsp/Makefile
--- a/drivers/media/platform/sprd/vsp/Makefile
